{
  "config": "scripts/train_configs/cifar10.json",
  "model": "resnet18_cifar10",
  "dataset": "cifar10",
  "batch_size": 128,
  "epochs": 300,
  "validation_frequency": 5,
  "seed": 1,
  "criterion": "CrossEntropyLoss",
  "criterion_kwargs": {},
  "optimizer": "SGD",
  "lr": 0.1,
  "optimizer_kwargs": {
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "nesterov": "True"
  },
  "scheduler": "ReduceLROnPlateau",
  "scheduler_kwargs": {
    "factor": 0.1,
    "patience": 3,
    "threshold": 0.001,
    "mode": "max"
  },
  "debug": false
}